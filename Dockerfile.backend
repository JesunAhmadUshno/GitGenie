# Express backend. server:build bundles server/index.ts and its dependencies into one file,
# so the runtime image needs no node_modules.

# Stage 1: Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY server ./server
RUN npm run server:build

# Stage 2: Production
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3001

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S express-user -u 1001

COPY --from=builder --chown=express-user:nodejs /app/dist/server.js ./dist/server.js

USER express-user

EXPOSE 3001

CMD ["node", "dist/server.js"]

# Next.js frontend. next.config sets output: 'export' with basePath /GitGenie, so the build is
# a static site in out/; the runner serves it under /GitGenie/ and redirects / there.

# Stage 1: Builder
FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

# Stage 2: Production
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production

# Static file server, and a non-root user for security
RUN npm install -g serve@14.2.4 && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

COPY --from=builder --chown=nextjs:nodejs /app/out ./site/GitGenie
RUN echo '{"redirects":[{"source":"/","destination":"/GitGenie/"}]}' > site/serve.json

USER nextjs

EXPOSE 3000

CMD ["serve", "-l", "tcp://0.0.0.0:3000", "site"]

{
  "name": "gitgenie",
  "version": "0.1.0",
  "description": "GitHub Achievement Alchemist - Interactive platform to unlock all GitHub badges",
  "author": "Jesun Ahmad Ushno",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/achievements.test.ts",
    "test:unit": "node --experimental-strip-types --test --test-reporter=spec tests/achievements.test.ts",
    "test:e2e": "playwright test",
    "server:dev": "tsx watch server/index.ts",
    "server:build": "tsc --project server/tsconfig.json",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate"
  },
  "dependencies": {
    "autoprefixer": "10.4.27",
    "axios": "1.13.6",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "dotenv": "^17.3.1",
    "express": "5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "12.34.3",
    "gsap": "3.14.2",
    "helmet": "^8.1.0",
    "js-cookie": "3.0.5",
    "next": "16.1.6",
    "postcss": "8.5.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "socket.io-client": "4.8.3",
    "tailwind-merge": "3.5.0",
    "typescript": "5.9.3",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@types/react": "19.2.14",
    "eslint": "10.0.2",
    "prettier": "3.8.1",
    "tailwindcss": "^3.4.19",
    "tsx": "4.21.0"
  }
}
